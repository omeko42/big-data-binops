# Ignore everything in the local working workspace by default
/*

# Explicitly allow only clean, sanitized, general application directories and docs
!/.gitignore
!/.env.example
!/README.md
!/SECURITY.md
!/backend/
!/frontend/
!/database/
!/docs/

# Always ignore environment secrets, node_modules, and build artifacts inside allowed dirs
node_modules/
.env
.env.*
!.env.example
*.bak*
*.log
