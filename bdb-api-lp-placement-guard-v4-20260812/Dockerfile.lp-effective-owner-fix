RUN npm test -- --runInBand src/bdb/common/lp-scope.util.spec.ts src/bdb/laporan-polisi/satker-placement.util.spec.ts
RUN node -e "const c=require('./config/dors-unit-mapping.json'); if(c.units.RESKRIM!=='RESKRIM'||c.polsek_min_lp_id!==404912) process.exit(1)"
RUN grep -q "count(distinct c.id) = 1" src/bdb/laporan-polisi/laporan-polisi.service.ts \
 && grep -q "bdb_lp_pelimpahan ph" src/bdb/laporan-polisi/laporan-polisi.service.ts
RUN npm run build
