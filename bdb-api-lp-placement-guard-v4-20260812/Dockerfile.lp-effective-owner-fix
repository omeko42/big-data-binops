COPY src/bdb/laporan-polisi/laporan-polisi.service.ts src/bdb/laporan-polisi/laporan-polisi.service.ts
COPY src/bdb/workflow/workflow.service.ts src/bdb/workflow/workflow.service.ts
COPY src/bdb/barang-bukti/barang-bukti.service.ts src/bdb/barang-bukti/barang-bukti.service.ts
COPY src/bdb/barang-bukti/barang-bukti.controller.ts src/bdb/barang-bukti/barang-bukti.controller.ts
COPY src/bdb/pihak-terlibat/pihak-terlibat.service.ts src/bdb/pihak-terlibat/pihak-terlibat.service.ts
COPY src/bdb/pihak-terlibat/pihak-terlibat.controller.ts src/bdb/pihak-terlibat/pihak-terlibat.controller.ts
