{
    "name": "bareskrim_nest_v11",
    "version": "1.0.0",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node --max-http-header-size=262144 dist/main.js",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "typeorm": "typeorm-ts-node-commonjs",
        "schema:sync": "npx typeorm-ts-node-commonjs schema:sync",
        "typeorm:cache": "npx typeorm-ts-node-commonjs cache:clear",
        "schema:drop": "npx typeorm-ts-node-commonjs -d ./src/app_core/database/dataSource.ts",
        "migration:create": "typeorm migration:create ./src/app_core/migrations/schema-update",
        "migration:generate": "npx typeorm-ts-node-commonjs migration:generate ./src/app_core/migrations/schema-update -d ./src/app_core/database/dataSource.ts",
        "migration:show": "npx typeorm-ts-node-commonjs migration:show -d ./src/app_core/database/dataSource.ts",
        "migration:run": "npx typeorm-ts-node-commonjs migration:run -d  ./src/app_core/database/dataSource.ts",
        "migration:rollback": "npx typeorm-ts-node-commonjs migration:revert -d ./src/app_core/database/dataSource.ts"
    },
