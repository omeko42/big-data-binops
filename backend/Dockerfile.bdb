FROM node:22.14.0-alpine

# Chromium (utk Puppeteer -- generate PDF dokumentasi API klien) + qpdf (kunci PDF dgn password).
# Chromium hasil download npm install Puppeteer di-build utk glibc, tak jalan di Alpine (musl) --
# pakai paket Chromium Alpine sendiri & skip download bawaan Puppeteer.
RUN apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont qpdf
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

WORKDIR /usr/src/app

COPY package*.json ./
RUN npm ci
# pm2-runtime -- WAJIB utk cluster mode (ecosystem.config.js, instances:32, lihat audit performa
# 2026-08-05). npm run start:prod (node dist/main.js polos) cuma 1 proses, tak pernah pakai
# ecosystem.config.js sama sekali -- itu bug lama yg baru ketahuan (tuning pool/koneksi di
# database.module.ts/dataSource.ts diasumsikan jalan di 32 proses paralel, padahal sebelum ini
# cuma 1). Global (bukan dependency proyek) krn ini tool operasional container, bukan bagian app.
RUN npm install -g pm2

COPY . .
RUN npm run build

ENV NODE_ENV=production
ENV PORT=3850
ENV TZ=Asia/Jakarta

EXPOSE 3850

CMD ["pm2-runtime", "start", "ecosystem.config.js"]
