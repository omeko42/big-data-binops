# Konfigurasi Runtime Lokal Coserse 1.0 (SANDBOX / LOCALHOST ONLY)
# Copy nilai relevan ke backend/.env saat menjalankan pengujian lokal.

# ==========================================================
# 1. ISOLASI JARINGAN OLLAMA / LLAMA.CPP (LOOPBACK ONLY!)
# ==========================================================
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_ORIGINS=http://127.0.0.1:*,http://localhost:*
OLLAMA_NUM_PARALLEL=2
OMP_NUM_THREADS=8
OLLAMA_MAX_LOADED_MODELS=1

# Provider lokal BDB: "ollama" (default) atau "llamacpp"
COSERSE_RUNTIME_PROVIDER=ollama
COSERSE_OLLAMA_URL=http://127.0.0.1:11434/api/chat
COSERSE_OLLAMA_TAGS_URL=http://127.0.0.1:11434/api/tags
COSERSE_LLAMA_CPP_URL=http://127.0.0.1:8080/v1/chat/completions
COSERSE_MODEL_NAME=coserse:1.0
COSERSE_LLM_TIMEOUT_MS=45000
COSERSE_NUM_CTX=4096
COSERSE_TEMPERATURE=0.1
COSERSE_NUM_THREAD=8

# Jika Ollama/Llama.cpp belum dijalankan di localhost dan ingin uji integrasi
# ringkasan perkara secara deterministik, set ke "true" khusus di sandbox lokal.
COSERSE_OFFLINE_DETERMINISTIC_FALLBACK=false

# ==========================================================
# 2. KONTROL KUOTA MEMORI, SLIDING WINDOW & TOKEN (100% GRATIS)
# ==========================================================
COSERSE_MEMORY_DEFAULT_MB=10
COSERSE_MEMORY_MAX_MB=50
COSERSE_SESSION_TTL_SECONDS=43200
COSERSE_MAX_SLIDING_TURNS=6
COSERSE_QUOTA_5H_TOKENS=20000
COSERSE_QUOTA_WEEKLY_TOKENS=100000
COSERSE_QUOTA_WEEKLY_MAX_TOKENS=150000
