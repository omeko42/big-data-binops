# BDB API example env. Copy to .env on the target server and fill secrets there.
FRONTEND=http://localhost:5173
PORT=3850
GLOBAL_PREFIX=api
TZ=Asia/Jakarta

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=bdb_app
DB_PASSWORD=change_me
DB_DATABASE=bdb_dev

# Default local mode: memory cache only. Set REDIS_ENABLED=true only when Redis is ready.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
MEMORY_CACHE_TTL_MS=60000

# Initial BDB superadmin seed. Fill password on the server, not in repo.
BDB_SUPERADMIN_NAME=BDB Superadmin Dev
BDB_SUPERADMIN_EMAIL=superadmin@bareskrim.polri.go.id
BDB_SUPERADMIN_PASSWORD=change_me

# Fill only on the server. Do not commit real values.
CAPTCHA_SECRET=change_me
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=change_me
EXTERNAL_SERVICE_TOKENS=change_me
EXTERNAL_SWAGGER_PASSWORD=change_me

EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SSL=false

# Future DORS sync. Fill from approved DORS credential source only.
DORS_API_BASE_URL=
DORS_CLIENT_ID=
DORS_CLIENT_SECRET=
DORS_USERNAME=
DORS_PASSWORD=
BDB_IMPORT_SCOPE=TEST
BDB_IMPORT_BATCH=
