import { Entity, PrimaryGeneratedColumn, Column, CreateDateColumn, UpdateDateColumn, DeleteDateColumn, ManyToOne, JoinColumn, OneToMany } from 'typeorm';
import { DirectorateTeam } from './directorate-team.entity';
import { LogReport } from '@bareskrim/report/entities/log-report.entity';
import { Report } from '@bareskrim/report/entities/report.entity';
import { DirectorateReport } from '@bareskrim/report/entities/directorate-report.entity';
import { DirectorateRole } from './directorate-role.entity';
import { Timestamps } from '@app_core/helper/entity/timestamp.entitiy';

@Entity('trb_dir')
export class Directorate {
    @PrimaryGeneratedColumn('increment', { type: 'bigint' })
    id: number;

    @Column({ type: 'varchar', length: 255, nullable: true })
    name: string;

    @Column({ type: 'int', default: () => 0 })
    status: string;

    @OneToMany(() => DirectorateTeam, DirectorateTeam => DirectorateTeam.Directorate) // note: we will create author property in the Photo class below
    DirectorateTeam: DirectorateTeam[];

    @OneToMany(() => LogReport, LogReport => LogReport.Directorate) // note: we will create author property in the Photo class below
    LogReport: LogReport[];

    @OneToMany(() => DirectorateReport, DirectorateReport => DirectorateReport.Directorate) // note: we will create author property in the Photo class below
    DirectorateReport: DirectorateReport[];

    @OneToMany(() => DirectorateReport, DirectorateReport => DirectorateReport.DirectorateFrom) // note: we will create author property in the Photo class below
    DirectorateReportFrom: DirectorateReport[];

    @OneToMany(() => Report, Report => Report.Directorate) // note: we will create author property in the Photo class below
    Report: Report[];

    @OneToMany(() => DirectorateRole, Report => Report.Directorate) // note: we will create author property in the Photo class below
    DirectorateRole: DirectorateRole[];

    @Column(() => Timestamps, { prefix: false })
    Timestamps: Timestamps;
}
